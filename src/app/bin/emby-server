#!/bin/sh
#
# fnOS launcher for Emby Server.
#
# Based on the upstream /opt/emby-server/bin/emby-server script, adapted to
# fnOS paths. All paths are taken from the fnOS runtime environment:
#   TRIM_APPDEST         - installed application files (the "target" dir)
#   TRIM_PKGVAR          - persistent runtime data
#   TRIM_DATA_SHARE_PATHS - declared data-share directories (colon separated)
#
# The self-update flag of the upstream launcher is intentionally omitted:
# application updates are managed by the fnOS App Center.
#
# Emby asks for a restart by exiting with -restartexitcode (3); upstream relies
# on systemd to start it again. fnOS does not supervise application processes,
# so this wrapper acts as the supervisor: it restarts Emby when it exits with
# that code (for example after a plugin update) and forwards TERM/INT so
# `cmd/main stop` still stops the service gracefully. Without this, a plugin
# update would take the server down until it is started manually.

set -u

APP_DIR="${TRIM_APPDEST:-/var/apps/embyserver/target}"
APP_DATA_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"

SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -z "${SHARE_DIR}" ] || [ ! -d "${SHARE_DIR}" ]; then
    SHARE_DIR="${APP_DATA_DIR}"
fi

export AMDGPU_IDS_PATH="${APP_DIR}/share/libdrm/amdgpu.ids"
export EMBY_DATA="${APP_DATA_DIR}"
export FONTCONFIG_PATH="${APP_DIR}/etc/fonts"
export LD_LIBRARY_PATH="${APP_DIR}/lib"
export LIBVA_DRIVERS_PATH="${APP_DIR}/lib/dri"
export OCL_ICD_VENDORS="${APP_DIR}/etc/OpenCL/vendors"
export PATH="${APP_DIR}/bin:${PATH}"
export PCI_IDS_PATH="${APP_DIR}/share/hwdata/pci.ids"
export SSL_CERT_FILE="${APP_DIR}/etc/ssl/certs/ca-certificates.crt"
export VK_DRIVER_FILES="${APP_DIR}/share/vulkan/icd.d"
export VK_LAYER_PATH="${APP_DIR}/share/vulkan/explicit_layer.d"
export VK_IMPLICIT_LAYER_PATH="${APP_DIR}/share/vulkan/implicit_layer.d"
export XDG_CACHE_HOME="${EMBY_DATA}/cache"

# Workaround for Intel drivers on kernel 6.8 and above.
export NEOReadDebugKeys=1
export OverrideGpuAddressSpace=48

cd "${APP_DIR}" || exit 1

RESTART_EXIT_CODE=3
STOPPING=0
EMBY_PID=""

forward_term() {
    STOPPING=1
    if [ -n "${EMBY_PID}" ]; then
        kill -TERM "${EMBY_PID}" 2>/dev/null
    fi
}

trap forward_term TERM INT

while :; do
    "${APP_DIR}/system/EmbyServer" \
        -programdata "${APP_DATA_DIR}" \
        -ffdetect "${APP_DIR}/bin/ffdetect" \
        -ffmpeg "${APP_DIR}/bin/ffmpeg" \
        -ffprobe "${APP_DIR}/bin/ffprobe" \
        -restartexitcode "${RESTART_EXIT_CODE}" \
        -nolocalportconfig \
        -ignore_vaapi_enabled_flag \
        -defaultdirectory "${SHARE_DIR}" &
    EMBY_PID=$!

    wait "${EMBY_PID}"
    rc=$?
    child_pid="${EMBY_PID}"
    EMBY_PID=""

    if [ "${STOPPING}" -eq 1 ]; then
        # TERM/INT was forwarded; wait for the child to finish shutting down.
        wait "${child_pid}" 2>/dev/null
        exit 0
    fi

    if [ "${rc}" -eq "${RESTART_EXIT_CODE}" ]; then
        sleep 2
        continue
    fi

    exit "${rc}"
done
