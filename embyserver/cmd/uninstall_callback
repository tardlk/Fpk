#!/bin/bash

# Runs after uninstall cleanup.
# wizard/uninstall exposes wizard_delete_data so users can choose
# whether their Emby configuration and metadata are removed.

clean_dir() {
    local dir="$1"
    if [ -n "${dir}" ] && [ -d "${dir}" ]; then
        find "${dir}" -mindepth 1 -delete 2>/dev/null || true
    fi
}

if [ "${wizard_delete_data}" = "true" ]; then
    clean_dir "${TRIM_PKGVAR:-}"
    clean_dir "${TRIM_PKGHOME:-}"
fi

exit 0
